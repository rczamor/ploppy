modules = ["postgresql-16", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["cargo", "glibcLocales", "libiconv", "openssl", "pkg-config", "rustc"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Streamlit App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Direct Import"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Import Expenditures"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Import Intermediaries"

[[workflows.workflow]]
name = "Streamlit App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app_v2.py --server.port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Direct Import"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && python3 scripts/direct_import.py"

[[workflows.workflow]]
name = "Import Expenditures"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && PYTHONPATH=/home/runner/workspace python3 scripts/import_expenditures.py"

[[workflows.workflow]]
name = "Import Intermediaries"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && PYTHONPATH=/home/runner/workspace python3 scripts/import_intermediary_contributions.py"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[objectStorage]
defaultBucketID = "replit-objstore-000f835d-1f8c-4d74-9e63-000d4a7d878f"
